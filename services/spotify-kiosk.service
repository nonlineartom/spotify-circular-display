[Unit]
Description=Spotify Pi Display — Chromium kiosk
Conflicts=spotify-pygame.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Chromium is the largest memory consumer on the 1 GB panel; throttle it
# into reclaim before the global OOM killer considers go-librespot.
MemoryHigh=600M
ExecStart="@PROJECT_DIR@/display-launch.sh" chromium
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
Environment=DISPLAY_PORT=@DISPLAY_PORT@
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=default.target
