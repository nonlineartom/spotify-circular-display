[Unit]
Description=go-librespot Spotify Connect Receiver
Wants=network-online.target sound.target avahi-daemon.service
After=network-online.target sound.target avahi-daemon.service
Conflicts=raspotify.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@PROJECT_DIR_SYSTEMD@
Environment="HOME=@APP_HOME@"
ExecStart=/usr/local/bin/go-librespot --config_dir "@PROJECT_DIR@/go-librespot"
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
# The receiver is the appliance's raison d'etre: strongly prefer killing any
# other process when memory is exhausted.
OOMScoreAdjust=-500
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@PROJECT_DIR@/go-librespot"
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
